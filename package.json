{
  "name": "comb",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"next dev\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on dist-electron/main.js && nodemon --watch dist-electron --exec electron .\"",    "build": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "start": "next start -p 3000",
    "electron": "electron .",
    "desktop": "npm run build && npm run build:electron && electron .",
    "dist": "npm run build && npm run build:electron && electron-builder"
  },
  "build": {
    "appId": "com.comb.desktop",
    "productName": "comb",
    "files": [
      "out/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.3.1",
    "get-port": "^7.1.0",
    "groq-sdk": "^0.37.0",
    "imapflow": "^1.2.10",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lucide-react": "^0.563.0",
    "mailparser": "^3.9.3",
    "next": "16.1.6",
    "nodemailer": "^8.0.1",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.4.0",
    "type-fest": "^5.4.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.35",
    "@types/nodemailer": "^7.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  }
}
